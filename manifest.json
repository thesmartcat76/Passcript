{
    "manifest_version": 3,
    "name": "PassCript",
    "version": "5.0",
    "description": "A password encryptor for Chrome.",
    "permissions": [
        "storage",
        "activeTab",
        "scripting"
    ],
    "action": {
        "default_popup": "popup.html"
    },
    "icons": {
        "16": "icon16.png",
        "48": "icon48.png",
        "128": "icon128.png"
    }
}
